<?xml version="1.0" encoding="utf-8"?>
<!-- Home: large title, module status hero, quick actions, pinned shortcuts (grouped list),
     how-to and edge-to-edge contributor carousels, on opaque grouped cards over a flat background;
     MainActivity pads the scroller for the status bar and the floating nav pill (tag ie_scroll). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:tag="ie_scroll">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- ============ LARGE TITLE ============ -->
        <TextView
            android:id="@+id/home_large_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:tag="ie_large_title"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.IE.LargeTitle" />

        <TextView
            android:id="@+id/home_app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/version"
            android:textAppearance="@style/TextAppearance.IE.Subhead"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- ============ STATUS HERO ============
             Grouped inset card: identity header, then hairline-separated status rows. -->
        <ps.reso.instaeclipse.ui.glass.GlassCardView
            android:id="@+id/instagram_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ie_glass_fill"
            app:cardCornerRadius="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="16dp">

                    <FrameLayout
                        android:id="@+id/home_logo_container"
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <ImageView
                            android:id="@+id/instagram_logo"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/instagram_logo"
                            android:src="@drawable/ic_instagram_logo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/instagram_status_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/checking_instagram"
                            android:textAppearance="@style/TextAppearance.IE.Title2"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/home_version_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.IE.Subhead"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/instagram_info_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/instagram_info"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_ui_info"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/instagram_multi_button"
                    style="@style/Widget.IE.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="-12dp"
                    android:layout_marginBottom="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/multiple_versions_detected"
                    android:textAppearance="@style/TextAppearance.IE.Footnote"
                    android:visibility="gone" />

                <View
                    style="@style/IeHairline"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp" />

                <!-- Row: module / install state + variant (trailing value) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:id="@+id/home_status_pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp">

                            <ImageView
                                android:id="@+id/home_status_dot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/bg_home_status_dot" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/home_status_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/checking_instagram"
                            android:textAppearance="@style/TextAppearance.IE.Body" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/instagram_variant_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.IE.Body"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    style="@style/IeHairline"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="58dp" />

                <!-- Row: enabled feature count, opens the Features tab -->
                <LinearLayout
                    android:id="@+id/home_features_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <FrameLayout
                        android:id="@+id/home_features_icon_container"
                        android:layout_width="30dp"
                        android:layout_height="30dp">

                        <ImageView
                            android:id="@+id/home_features_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ui_tune" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/home_features_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.IE.Body"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ui_chevron_right"
                        app:tint="?attr/colorOutline" />
                </LinearLayout>
            </LinearLayout>
        </ps.reso.instaeclipse.ui.glass.GlassCardView>

        <!-- ============ QUICK ACTIONS ============ -->
        <TextView
            style="@style/IeHomeSection"
            android:text="@string/home_section_quick_actions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/launch_instagram_button"
                style="@style/Widget.IE.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/launch_instagram"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="76dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/home_action_launch"
                android:textAppearance="@style/TextAppearance.IE.Subhead.Emphasized"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_instagram_logo"
                app:iconGravity="top"
                app:iconPadding="6dp"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restart_instagram_button"
                style="@style/Widget.IE.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:textColor="@color/ie_tile_button_fg"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="76dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/home_action_restart"
                android:textAppearance="@style/TextAppearance.IE.Subhead.Emphasized"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_ui_restart"
                app:iconGravity="top"
                app:iconPadding="6dp"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/download_instagram_button"
                style="@style/Widget.IE.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/download_apk"
                android:textColor="@color/ie_tile_button_fg"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="76dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/home_action_download"
                android:textAppearance="@style/TextAppearance.IE.Subhead.Emphasized"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_ui_download"
                app:iconGravity="top"
                app:iconPadding="6dp"
                app:iconSize="24dp" />
        </LinearLayout>

        <!-- ============ QUICK SHORTCUTS ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/home_section_shortcuts"
                android:textAppearance="@style/TextAppearance.IE.SectionTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_shortcuts_edit"
                style="@style/Widget.IE.Button.GlassIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/home_shortcuts_edit"
                android:tooltipText="@string/home_shortcuts_edit"
                app:icon="@drawable/ic_ui_edit"
                tools:ignore="SpeakableTextPresentCheck" />
        </LinearLayout>

        <ps.reso.instaeclipse.ui.glass.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/home_shortcuts_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/home_shortcuts_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="20dp"
                    android:text="@string/home_shortcuts_empty"
                    android:textAppearance="@style/TextAppearance.IE.Subhead"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    app:drawableTopCompat="@drawable/ic_ui_edit" />
            </LinearLayout>
        </ps.reso.instaeclipse.ui.glass.GlassCardView>

        <TextView
            android:id="@+id/home_shortcuts_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/home_shortcuts_hint"
            android:textAppearance="@style/TextAppearance.IE.Footnote"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- ============ HOW TO USE ============ -->
        <TextView
            style="@style/IeHomeSection"
            android:text="@string/how_to_use" />

        <ps.reso.instaeclipse.ui.glass.GlassCardView
            android:id="@+id/how_to_use_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/home_howto_icon_container"
                    android:layout_width="30dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:id="@+id/search_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ui_search" />
                </FrameLayout>

                <TextView
                    android:id="@+id/instruction_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/usage_instructions"
                    android:textAppearance="@style/TextAppearance.IE.Subhead"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </ps.reso.instaeclipse.ui.glass.GlassCardView>

        <!-- ============ CONTRIBUTORS ============ -->
        <TextView
            style="@style/IeHomeSection"
            android:text="@string/contributors" />

        <ps.reso.instaeclipse.utils.ui.LoopScrollView
            android:id="@+id/contributors_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contributors_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="4dp" />
        </ps.reso.instaeclipse.utils.ui.LoopScrollView>

        <!-- ============ SPECIAL THANKS ============ -->
        <TextView
            style="@style/IeHomeSection"
            android:text="@string/special_thanks" />

        <ps.reso.instaeclipse.utils.ui.LoopScrollView
            android:id="@+id/special_thanks_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/special_thanks_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="4dp" />
        </ps.reso.instaeclipse.utils.ui.LoopScrollView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
