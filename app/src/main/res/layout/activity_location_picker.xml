<?xml version="1.0" encoding="utf-8"?>
<!-- Edge-to-edge map; floating glass chrome (search capsule, results, place card) is kept clear of
     the system bars by LocationPickerActivity (loc_top_panel padding, loc_place_card margin). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <FrameLayout
        android:id="@+id/loc_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Pin whose tip marks the map center -->
        <ImageView
            android:id="@+id/center_pin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_pin"
            android:translationY="-24dp"
            app:tint="?attr/colorPrimary" />

        <!-- Top: back + search bar, search results, recent places -->
        <LinearLayout
            android:id="@+id/loc_top_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <ps.reso.instaeclipse.ui.glass.GlassCardView
                android:id="@+id/search_card"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:elevation="6dp"
                app:cardBackgroundColor="@color/ie_glass_chrome_fallback"
                app:cardCornerRadius="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="6dp">

                    <ImageButton
                        android:id="@+id/btn_back"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/back"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/loc_picker_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="6dp"
                        android:textAppearance="@style/TextAppearance.IE.Body"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textDirection="locale" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/search_progress"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="8dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="20dp"
                        app:trackThickness="2dp" />

                    <ImageButton
                        android:id="@+id/search_clear"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </ps.reso.instaeclipse.ui.glass.GlassCardView>

            <ps.reso.instaeclipse.ui.glass.GlassCardView
                android:id="@+id/results_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:elevation="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ie_glass_chrome_fallback"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:id="@+id/results_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp" />
            </ps.reso.instaeclipse.ui.glass.GlassCardView>

            <HorizontalScrollView
                android:id="@+id/recent_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/recent_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Bottom: place card with name, coordinates and the confirm button -->
        <ps.reso.instaeclipse.ui.glass.GlassCardView
            android:id="@+id/loc_place_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="8dp"
            app:cardBackgroundColor="@color/ie_glass_chrome_fallback"
            app:cardCornerRadius="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/place_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/loc_picker_locating"
                    android:textAppearance="@style/TextAppearance.IE.Title3"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/coord_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textAppearance="@style/TextAppearance.IE.Footnote"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAlignment="viewStart"
                    android:textDirection="ltr" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_use"
                    style="@style/Widget.IE.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="52dp"
                    android:text="@string/loc_picker_use"
                    app:icon="@drawable/ic_pin"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </ps.reso.instaeclipse.ui.glass.GlassCardView>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
