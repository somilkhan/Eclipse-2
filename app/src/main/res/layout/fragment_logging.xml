<?xml version="1.0" encoding="utf-8"?>
<!-- Logs: large title, filter chips, toolbar (count/status + actions), and the log console on a
     glass card. Insets: ie_inset_top / ie_inset_bottom (MainActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="ie_inset_top">

    <TextView
        android:id="@+id/logs_large_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:text="@string/logging"
        android:textAppearance="@style/TextAppearance.IE.LargeTitle" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/logs_filter_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@+id/logs_chip_all"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/logs_chip_all"
                    style="@style/Widget.IE.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/logs_filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/logs_chip_hooked"
                    style="@style/Widget.IE.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/logs_filter_hooked" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/logs_chip_errors"
                    style="@style/Widget.IE.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/logs_filter_errors" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/logs_chip_warnings"
                    style="@style/Widget.IE.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/logs_filter_warnings" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Toolbar: count + status take the remaining width, actions are 48dp glass buttons. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/logs_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/logs_loading"
                android:textAppearance="@style/TextAppearance.IE.Subhead.Emphasized"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/logs_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.IE.Footnote"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_refresh"
                style="@style/Widget.IE.Button.GlassIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/logs_refresh"
                android:tooltipText="@string/logs_refresh"
                app:icon="@drawable/ic_ui_refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_copy"
                style="@style/Widget.IE.Button.GlassIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/logs_copy"
                android:tooltipText="@string/logs_copy"
                app:icon="@drawable/ic_ui_content_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_save"
                style="@style/Widget.IE.Button.GlassIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/logs_save"
                android:tooltipText="@string/logs_save"
                app:icon="@drawable/ic_ui_download" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logs_clear"
                style="@style/Widget.IE.Button.GlassIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/logs_clear"
                android:tooltipText="@string/logs_clear"
                app:icon="@drawable/ic_ui_delete" />

    </LinearLayout>

    <!-- Log console -->
    <ps.reso.instaeclipse.ui.glass.GlassCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:tag="ie_inset_bottom_margin">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/logs_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

            <LinearLayout
                android:id="@+id/logs_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_empty_glyph"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ui_terminal"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/logs_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/logs_empty_title"
                    android:textAppearance="@style/TextAppearance.IE.Title3"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/logs_empty_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxWidth="320dp"
                    android:text="@string/logs_empty_body"
                    android:textAppearance="@style/TextAppearance.IE.Subhead"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logs_empty_refresh"
                    style="@style/Widget.IE.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/logs_refresh"
                    app:icon="@drawable/ic_ui_refresh" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/logs_progress"
                style="@style/Widget.IE.LinearProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </ps.reso.instaeclipse.ui.glass.GlassCardView>
</LinearLayout>
