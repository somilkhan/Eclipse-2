<?xml version="1.0" encoding="utf-8"?>
<!-- Advanced colour picker (dialog body). Hue/saturation pad, hex field in a glass capsule,
     per-channel sliders and opacity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <io.github.somilkhan.instaeclipse2.ui.theme.AdvancedColorPickerView
        android:id="@+id/color_picker_view"
        android:layout_width="match_parent"
        android:layout_height="220dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_capsule"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <View
            android:id="@+id/color_preview_swatch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/color_hex_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="#RRGGBB"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.IE.Body"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textDirection="ltr" />
    </LinearLayout>

    <TextView
        android:id="@+id/color_rgb_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:fontFamily="monospace"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.IE.Footnote"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textDirection="ltr" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="R"
            android:textAppearance="@style/TextAppearance.IE.Subhead.Emphasized"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <SeekBar
            android:id="@+id/color_red_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="R"
            android:progressTint="#FF453A"
            android:thumbTint="#FF453A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="G"
            android:textAppearance="@style/TextAppearance.IE.Subhead.Emphasized"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <SeekBar
            android:id="@+id/color_green_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="G"
            android:progressTint="#30D158"
            android:thumbTint="#30D158" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="B"
            android:textAppearance="@style/TextAppearance.IE.Subhead.Emphasized"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <SeekBar
            android:id="@+id/color_blue_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="B"
            android:progressTint="#0A84FF"
            android:thumbTint="#0A84FF" />
    </LinearLayout>

    <TextView
        android:id="@+id/color_alpha_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textAppearance="@style/TextAppearance.IE.Subhead.Emphasized"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <SeekBar
        android:id="@+id/color_alpha_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:minHeight="40dp"
        android:progressTint="?attr/colorPrimary"
        android:thumbTint="?attr/colorPrimary" />

</LinearLayout>
