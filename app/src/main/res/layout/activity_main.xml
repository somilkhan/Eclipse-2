<?xml version="1.0" encoding="utf-8"?>
<!-- Edge-to-edge shell: content scrolls under a blurred compact top bar and a floating glass
     navigation pill. Insets are applied in MainActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Compact bar: invisible over the large title, frosts in once it scrolls underneath. -->
    <ps.reso.instaeclipse.ui.glass.BackdropBlurLayout
        android:id="@+id/top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:alpha="0"
        android:importantForAccessibility="no"
        app:ieBlurRadius="24dp"
        app:ieCornerRadius="0dp">

        <TextView
            android:id="@+id/toolbar_title_name"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginHorizontal="72dp"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.IE.Headline" />

        <View
            android:id="@+id/top_app_bar_hairline"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_gravity="bottom"
            android:background="@color/ie_separator" />
    </ps.reso.instaeclipse.ui.glass.BackdropBlurLayout>

    <!-- Soft contact shadow under the pill (a blurred-looking gradient; elevation shadows
         render as hard grey rings on translucent shapes). -->
    <View
        android:id="@+id/bottom_navigation_shadow"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="28dp"
        android:background="@drawable/bg_nav_shadow"
        android:importantForAccessibility="no" />

    <ps.reso.instaeclipse.ui.glass.GlassNavPill
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:maxWidth="480dp"
        app:ieBlurRadius="30dp"
        app:ieMenu="@menu/bottom_navigation_menu" />

</FrameLayout>
