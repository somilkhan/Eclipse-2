<?xml version="1.0" encoding="utf-8"?>
<!-- Theme customizer: same chrome as the tabs. Large title scrolls under a frosted compact bar
     (theme_top_bar) that fades in; the floating back button stays on top. Insets are applied in
     ThemeCustomizerActivity (edge-to-edge). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/theme_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/theme_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/theme_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="beforeDescendants"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="56dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ============ LARGE TITLE ============ -->
            <TextView
                android:id="@+id/theme_large_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:accessibilityHeading="true"
                android:text="@string/theme_title"
                android:textAppearance="@style/TextAppearance.IE.LargeTitle" />

            <TextView
                android:id="@+id/theme_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAppearance="@style/TextAppearance.IE.Subhead"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Master enable switch -->
            <ps.reso.instaeclipse.ui.glass.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_icon_tile_palette"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/ic_ui_palette"
                        app:tint="@color/ie_on_accent_tile" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_enable"
                        android:textAppearance="@style/TextAppearance.IE.Body"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/theme_enable_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/theme_enable" />
                </LinearLayout>
            </ps.reso.instaeclipse.ui.glass.GlassCardView>

            <!-- Presets section -->
            <LinearLayout
                android:id="@+id/theme_presets_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/theme_section_presets"
                    android:textAppearance="@style/TextAppearance.IE.SectionTitle" />

                <ImageView
                    android:id="@+id/theme_presets_expand_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/theme_collapse_section"
                    android:padding="6dp"
                    android:src="@drawable/ic_ui_expand_less"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/theme_presets_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Preset cards carry a 6dp margin: pull the grid out so card edges align. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/theme_preset_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Custom colors section -->
            <LinearLayout
                android:id="@+id/theme_custom_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/theme_section_custom"
                    android:textAppearance="@style/TextAppearance.IE.SectionTitle" />

                <ImageView
                    android:id="@+id/theme_custom_expand_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/theme_collapse_section"
                    android:padding="6dp"
                    android:src="@drawable/ic_ui_expand_less"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/theme_custom_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ps.reso.instaeclipse.ui.glass.GlassCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/theme_color_slots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </ps.reso.instaeclipse.ui.glass.GlassCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_reset_custom"
                    style="@style/Widget.IE.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/theme_reset_custom"
                    app:icon="@drawable/ic_ui_restart"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Compact bar: transparent over the large title, frosts in once it scrolls underneath. -->
    <ps.reso.instaeclipse.ui.glass.BackdropBlurLayout
        android:id="@+id/theme_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants"
        app:ieBlurRadius="24dp"
        app:ieCornerRadius="0dp">

        <TextView
            android:id="@+id/theme_compact_title"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="72dp"
            android:layout_marginEnd="72dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/theme_title"
            android:textAppearance="@style/TextAppearance.IE.Headline" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_gravity="bottom"
            android:background="@color/ie_separator" />
    </ps.reso.instaeclipse.ui.glass.BackdropBlurLayout>

    <!-- Toolbar only hosts the back button (always visible, glass circle). -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/theme_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        app:contentInsetStart="0dp"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_ui_arrow_back"
        app:navigationIconTint="?attr/colorPrimary" />
</FrameLayout>
