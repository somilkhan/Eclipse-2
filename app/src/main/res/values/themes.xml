<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 0.8.4 "liquid glass": branded palette in light + dark (values-night/colors.xml), drawn
         edge-to-edge over a soft mesh backdrop (bg_mesh) so translucent glass surfaces read.
         Dynamic Colors stay off on purpose: the companion matches the in-IG sheet's brand. -->
    <style name="Theme.InstaEclipse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_mesh</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/ie_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/ie_light_bars</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>

        <!-- Primary / accent -->
        <item name="colorPrimary">@color/ie_primary</item>
        <item name="colorOnPrimary">@color/ie_on_primary</item>
        <item name="colorPrimaryContainer">@color/ie_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ie_on_primary_container</item>
        <item name="colorSecondary">@color/ie_secondary</item>
        <item name="colorOnSecondary">@color/ie_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ie_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ie_on_secondary_container</item>
        <item name="colorTertiary">@color/ie_tertiary</item>
        <item name="colorOnTertiary">@color/ie_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/ie_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ie_on_tertiary_container</item>

        <!-- Surfaces / background -->
        <item name="android:colorBackground">@color/ie_background</item>
        <item name="colorOnBackground">@color/ie_on_surface</item>
        <item name="colorSurface">@color/ie_surface</item>
        <item name="colorOnSurface">@color/ie_on_surface</item>
        <item name="colorSurfaceVariant">@color/ie_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ie_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/ie_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/ie_surface_low</item>
        <item name="colorSurfaceContainer">@color/ie_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/ie_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/ie_surface_highest</item>
        <item name="colorOutline">@color/ie_outline</item>
        <item name="colorOutlineVariant">@color/ie_outline_variant</item>
        <item name="colorError">@color/ie_error</item>
        <item name="colorOnError">@color/ie_on_error</item>

        <!-- Type scale (SF-like rhythm, all sp so it follows the user's font scale) -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.IE.LargeTitle</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.IE.Title1</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.IE.Title2</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.IE.Title3</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.IE.Headline</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.IE.Subhead.Emphasized</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.IE.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.IE.Subhead</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.IE.Footnote</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.IE.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.IE.Caption.Emphasized</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.IE.Caption2</item>

        <!-- Component defaults -->
        <item name="materialCardViewStyle">@style/Widget.IE.Card</item>
        <item name="materialButtonStyle">@style/Widget.IE.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.IE.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.IE.Button.Text</item>
        <item name="chipStyle">@style/Widget.IE.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.IE.Dialog</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.IE.ExtendedFab</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.IE.LinearProgress</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.IE.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.IE.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.IE.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.IE.ExtraLarge</item>
    </style>

    <!-- Dialogs: rounded sheet; on API 31+ values-v31 makes it real frosted glass with blur. -->
    <style name="ThemeOverlay.IE.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.IE.Dialog</item>
        <item name="backgroundTint">@color/ie_dialog_bg</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.IE.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.IE.Button.DialogText</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.IE.Button.DialogText</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.IE.Button.DialogText</item>
    </style>
</resources>
