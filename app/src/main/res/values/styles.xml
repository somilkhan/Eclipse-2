<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ToolbarTitleTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ShapeAppearance.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="SpinnerPopup" parent="Theme.AppCompat.Light">
        <item name="android:textAppearance">@style/SpinnerTextAppearance</item>
        <item name="android:background">@color/ie_glass_fill</item>
    </style>
    <style name="SpinnerTextAppearance" parent="TextAppearance.AppCompat.Body1">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">16sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ie_on_surface</item>
    </style>

    <!-- Compact grouped rows retain their existing layout/style contracts. -->
    <style name="MenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="MenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/ie_separator</item>
    </style>
    <style name="SubmenuCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/ie_glass_fill</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ie_glass_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- SettingsActivity.label(): 11.5sp medium, uppercase, 0.14em tracking. -->
    <style name="IeSectionLabel" parent="TextAppearance.IE.Footnote">
        <item name="android:textSize">11.5sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="IeHairline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/ie_separator</item>
    </style>
    <style name="SubmenuSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <!-- Native sans-serif matches the reference; no new font dependency/assets. -->
    <style name="TextAppearance.IE.Default" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.IE.Default.Small" parent="android:TextAppearance.Material.Small">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.IE.Default.Medium" parent="android:TextAppearance.Material.Medium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.IE.Default.Large" parent="android:TextAppearance.Material.Large">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.IE.Display.Large" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">50sp</item>
        <item name="lineHeight">56sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.IE.Display.Medium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">40sp</item>
        <item name="lineHeight">46sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.IE.Display.Small" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">32sp</item>
        <item name="lineHeight">38sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Editorial 40sp page headings; 15.5sp rows and 12.5sp supporting copy.
         All sizes use sp so accessibility font scaling remains enabled. -->
    <style name="TextAppearance.IE.LargeTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">40sp</item>
        <item name="lineHeight">46sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.IE.Title1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">32sp</item>
        <item name="lineHeight">38sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.IE.Title2" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">30sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.IE.Title3" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.IE.Headline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">15.5sp</item>
        <item name="lineHeight">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.IE.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15.5sp</item>
        <item name="lineHeight">21sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.IE.Callout" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="lineHeight">21sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.IE.Subhead" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12.5sp</item>
        <item name="lineHeight">17sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.IE.Subhead.Emphasized">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.IE.Footnote" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12.5sp</item>
        <item name="lineHeight">17sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.IE.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.IE.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.IE.Caption.Emphasized">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.IE.Caption2" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="lineHeight">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.IE.SectionTitle" parent="TextAppearance.IE.Title3">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- Reference section rhythm: 22dp above, 8dp side/bottom inset. -->
    <style name="IeHomeSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:textAppearance">@style/IeSectionLabel</item>
    </style>

    <!-- Reference card radius is 18dp; capsules remain fully rounded. -->
    <style name="ShapeAppearance.IE.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.IE.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.IE.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.IE.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">22dp</item>
    </style>
    <style name="ShapeAppearance.IE.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.IE.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- GlassCardView already draws its own 0.75dp hairline from ie_glass_outline;
         leave Material stroke off to avoid drawing the fine edge twice. -->
    <style name="Widget.IE.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/ie_glass_fill</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/ie_ripple</item>
    </style>
    <style name="Widget.IE.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.IE.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IE.Full</item>
    </style>
    <style name="Widget.IE.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.IE.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IE.Full</item>
        <item name="backgroundTint">@color/ie_tonal_button_bg</item>
        <item name="android:textColor">@color/ie_tonal_button_fg</item>
        <item name="iconTint">@color/ie_tonal_button_fg</item>
        <item name="strokeColor">@color/ie_glass_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.IE.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.IE.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IE.Full</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="strokeColor">@color/ie_separator</item>
    </style>
    <style name="Widget.IE.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.IE.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IE.Full</item>
    </style>
    <style name="Widget.IE.Button.DialogText" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.IE.Headline</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IE.Full</item>
    </style>
    <!-- Neutral capsule secondary action; only primary/selected controls are coral. -->
    <style name="Widget.IE.Button.Capsule" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">15sp</item>
        <item name="android:textAppearance">@style/TextAppearance.IE.Subhead.Emphasized</item>
        <item name="android:textColor">@color/ie_capsule_fg</item>
        <item name="backgroundTint">@color/ie_fill_capsule</item>
        <item name="iconTint">@color/ie_capsule_fg</item>
        <item name="iconSize">17dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/ie_ripple</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IE.Full</item>
    </style>
    <style name="Widget.IE.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/ie_checkbox_tint</item>
    </style>
    <style name="Widget.IE.Button.PlainIcon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="iconSize">20dp</item>
        <item name="rippleColor">@color/ie_ripple</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IE.Full</item>
    </style>
    <style name="Widget.IE.Button.GlassIcon" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="backgroundTint">@color/ie_glass_fill_raised</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="iconSize">20dp</item>
        <item name="strokeColor">@color/ie_glass_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IE.Full</item>
    </style>
    <style name="Widget.IE.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/ie_chip_bg</item>
        <item name="android:textColor">@color/ie_chip_fg</item>
        <item name="checkedIconTint">@color/ie_chip_fg</item>
        <item name="chipStrokeColor">@color/ie_glass_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textAppearance">@style/TextAppearance.IE.Subhead.Emphasized</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IE.Full</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
    <style name="Widget.IE.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.IE.Full</item>
        <item name="android:textAppearance">@style/TextAppearance.IE.Headline</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>
    <style name="Widget.IE.LinearProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackCornerRadius">2dp</item>
        <item name="trackColor">@android:color/transparent</item>
    </style>
    <style name="MaterialAlertDialog.IE.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.IE.Title3</item>
    </style>
    <!-- On = coral, off = neutral. Keep existing switch state-list resource contracts. -->
    <style name="Widget.IE.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/ie_switch_thumb_tint</item>
        <item name="trackTint">@color/ie_switch_track_tint</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>
</resources>
