<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on API 28-30 (see data_extraction_rules.xml for API 31+).
     Settings (shared_prefs) are backed up. Logs are not: they are diagnostic, can be several MB,
     and contain account/thread details that must not end up in a cloud backup. -->
<full-backup-content>
    <exclude domain="file" path="ig_logs/" />
    <exclude domain="file" path="instaeclipse_companion.log" />
    <exclude domain="file" path="instaeclipse_logging.log" />
</full-backup-content>
